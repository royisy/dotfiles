# user.name / user.email are intentionally NOT set here.
# This repository is public, so the Git identity is kept machine-local in
# ~/.gitconfig.local (see the [include] at the bottom of this file).
[pager]
	branch = false
[core]
	editor = vi
	pager = hunk pager
[merge]
	conflictStyle = zdiff3
[push]
	autoSetupRemote = true
[include]
	path = ~/.gitconfig.local
