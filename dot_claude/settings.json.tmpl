{
  "permissions": {
    "allow": [
      "Bash(win-notify:*)",
      "Bash(grep:*)",
      "Bash(ruff format:*)",
      "Bash(ruff check:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message // \"\"' | { read -r m; case \"$m\" in *\"waiting for your input\"*) exit 0 ;; esac; zsh -c 'source ~/.config/zsh/win-notify.sh; win-notify \"Input needed.\" \"Claude\"' ; [ -n \"$TMUX_PANE\" ] && printf '\\a' > \"$(tmux display-message -p -t \"$TMUX_PANE\" '#{pane_tty}')\" ; } 2>/dev/null",
            "statusMessage": "Notifying Windows",
            "async": true
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/herdr-pane-name.sh\"",
            "statusMessage": "herdr: sync pane name",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/herdr-pane-name.sh\"",
            "statusMessage": "herdr: sync pane name",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && { if [ \"$(tmux display-message -p -t \"$TMUX_PANE\" '#{window_active}')\" = 1 ]; then tmux set-option -uw -t \"$TMUX_PANE\" window-status-style; tmux set-option -uw -t \"$TMUX_PANE\" @busy; tmux set-option -uw -t \"$TMUX_PANE\" @claude_done; else tmux set-option -w -t \"$TMUX_PANE\" window-status-style 'bg=blue,fg=white'; tmux set-option -w -t \"$TMUX_PANE\" @busy 1; tmux set-option -w -t \"$TMUX_PANE\" @claude_done 1; fi; } 2>/dev/null",
            "statusMessage": "tmux: mark window done",
            "async": true
          },
          {
            "type": "command",
            "command": "zsh -c 'source ~/.config/zsh/win-notify.sh; win-notify \"Task complete.\" \"Claude\"' 2>/dev/null",
            "statusMessage": "Notifying Windows",
            "async": true
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/herdr-pane-name.sh\"",
            "statusMessage": "herdr: sync pane name",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && { tmux set-option -w -t \"$TMUX_PANE\" window-status-style 'bg=yellow,fg=black'; tmux set-option -w -t \"$TMUX_PANE\" @busy 1; tmux set-option -uw -t \"$TMUX_PANE\" @claude_done; } 2>/dev/null",
            "statusMessage": "tmux: mark window running",
            "async": true
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/herdr-pane-name.sh\"",
            "statusMessage": "herdr: sync pane name",
            "async": true
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": false,
    "eli5@claude-community": true
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "feedbackDrafts": "off",
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: royisy/dotfiles — PUBLIC",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (default); no branch protection rules or rulesets listed for royisy/dotfiles",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (royisy/dotfiles) and its remote (github.com/royisy/dotfiles) only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: {{ .chezmoi.homeDir }}/dotfiles (working directory) and its remote github.com/royisy/dotfiles.git — PUBLIC repo, so only this repo's own work is safe to commit/push there; confidential material and secrets are never cleared into it by visibility alone; content ported or first read from outside this session's repo is not its own work",
      "**Org-specific CLIs**: None configured",
      "routine under royisy/dotfiles prefix: git and file operations scoped to this repo's working tree are routine"
    ]
  }
}
