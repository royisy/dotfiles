export PATH="$HOME/.local/bin:$PATH"

# default editor
export EDITOR=nvim

if [ -f "$HOME/.oh-my-zshrc" ]; then
    source "$HOME/.oh-my-zshrc"
fi

if [ -f "$HOME/.config/zsh/win-notify.sh" ]; then
    source "$HOME/.config/zsh/win-notify.sh"
fi

# Keep the Herdr tab indicators running. This belongs in a systemd --user unit
# and used to be one, but the host security agent holds the cgroup root here,
# so user@.service fails at boot and takes every --user unit with it. The shell
# is what is left. --ensure returns immediately and starts nothing when a loop
# is already up, so the cost per shell is one short-lived process.
if [ -x "$HOME/.config/herdr/tab-status.sh" ]; then
    "$HOME/.config/herdr/tab-status.sh" --ensure
fi

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

# fzf: use fd and include hidden files (exclude .git); respects .gitignore
export FZF_DEFAULT_COMMAND='fd --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'

# fzf key bindings: Ctrl-T (files), Alt-C (cd into dir), Ctrl-R (history)
if [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]; then
    source /usr/share/doc/fzf/examples/key-bindings.zsh
fi
if [ -f /usr/share/doc/fzf/examples/completion.zsh ]; then
    source /usr/share/doc/fzf/examples/completion.zsh
fi

if [ -f "$HOME/.zshrc.local" ]; then
    source "$HOME/.zshrc.local"
fi

if command -v eza >/dev/null 2>&1; then
    alias ll='eza -la --group-directories-first --git'
else
    alias ll='ls -la'
fi

# Review the working tree in Hunk with auto-reload. Uses `hunk diff` (not the
# git pager) so --watch has a reopenable Git-backed input; shadows the seldom
# used `hd` hexdump symlink.
if command -v hunk >/dev/null 2>&1; then
    alias hd='hunk diff --watch'
fi
